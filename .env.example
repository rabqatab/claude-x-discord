DISCORD_TOKEN=your_discord_token
GEMINI_API_KEY=your_gemini_key
CODEX_API_KEY=your_codex_key
CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1

# CLI binary paths (optional — defaults to bare command name in PATH)
# NVM 환경에서는 전체 경로 설정 권장. Bridge가 이 경로에서 Node.js 위치를 추론하여
# PATH에 추가하므로, 비인터랙티브 셸(systemd, pm2)에서도 올바른 Node.js 버전 사용.
# 확인: nvm use 22 && which claude
CLAUDE_BIN=/home/user/.nvm/versions/node/v22.22.0/bin/claude
GEMINI_BIN=/home/user/.nvm/versions/node/v22.22.0/bin/gemini
CODEX_BIN=/home/user/.nvm/versions/node/v22.22.0/bin/codex
